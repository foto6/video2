{
  "name": "@foto6/media-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless deterministic media rendering engine.",
  "engines": {
    "node": ">=20"
  },
  "exports": "./src/index.js",
  "scripts": {
    "test": "node --test",
    "test:ci": "node --test --test-reporter=spec",
    "test:artifact": "node --test tests/artifact-manifest.test.js",
    "test:retention": "node --test tests/artifact-retention.test.js",
    "test:pin": "node --test tests/artifact-pin-lease.test.js",
    "test:stress": "node --test tests/media-soak.test.js tests/resource-scheduler.test.js",
    "test:pin-chaos": "node --test tests/pin-gc-chaos.test.js",
    "test:r10": "node --test tests/native-mcp-exposure-r10.test.js tests/creator-pin-recovery-r10.test.js",
    "test:r11": "node --test tests/shortform-r11.test.js",
    "demo:r11": "node tools/render-r11-demo.mjs",
    "verify:r11": "npm run test:r11 && npm run demo:r11",
    "test:r12": "node --test tests/creative-polish-r12.test.js",
    "demo:r12": "node tools/render-r12-demo.mjs",
    "verify:r12": "npm run test:r12 && npm run demo:r12",
    "test:r13": "node --test tests/creator-compat-r13.test.js",
    "emit:r13": "npm run demo:r12 && node tools/render-r13-compat.mjs",
    "verify:r13": "npm run test:r13 && node tools/verify-r13-determinism.mjs",
    "test:r14": "node --test tests/realworld-acceptance-r14.test.js",
    "generate:r14": "node tools/generate-r14-corpus.mjs",
    "accept:r14": "node tools/run-r14-acceptance.mjs --input-dir .artifacts/r14-corpus --output-dir .artifacts/r14-acceptance --manifest tests/fixtures/r14-acceptance/corpus.json",
    "verify:r14": "npm run test:r14 && npm run generate:r14 && npm run accept:r14",
    "accept:r14:folder": "node tools/run-r14-acceptance.mjs",
    "test:r15": "node --test tests/render-export-r15.test.js",
    "export:r15:batch": "node tools/export-r15-batch.mjs",
    "prove:r15:benchmark": "node tools/prove-r15-benchmark.mjs",
    "verify:r15": "npm run test:r15",
    "test:r16": "node --test tests/candidate-batch-r16.test.js",
    "demo:r16": "node tools/demo-r16-candidate-batch.mjs",
    "verify:r16": "npm run test:r16 && npm run demo:r16",
    "test:r17": "node --test tests/web-chat-review-r17.test.js",
    "build:r17": "node tools/build-r17-web-chat-review.mjs",
    "verify:r17": "npm run test:r17 && npm run demo:r16 && npm run build:r17"
  }
}
