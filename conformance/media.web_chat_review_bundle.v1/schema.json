{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.web_chat_review_bundle.v1",
  "title": "Media web-chat review bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "review_bundle_producer",
    "upstream_media_authority",
    "source",
    "candidate_batch",
    "attachment_policy",
    "candidates"
  ],
  "properties": {
    "contractVersion": { "const": "media.web_chat_review_bundle.v1" },
    "review_bundle_producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository","sha"],
      "properties": {
        "repository": { "const": "foto6/video2" },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "upstream_media_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion","repository","producerSha","ciRunId",
        "artifact","candidateBatch","source","candidates"
      ],
      "properties": {
        "contractVersion": { "const": "media.candidate_batch.v1" },
        "repository": { "const": "foto6/video2" },
        "producerSha": { "const": "231a0680c8939cfec77aaa283e507e93f383ad73" },
        "ciRunId": { "const": 36865890506 },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id","name","archiveDigest"],
          "properties": {
            "id": { "const": 11163920921 },
            "name": { "const": "media-r16-candidate-batch-demo" },
            "archiveDigest": { "const": "sha256:d929b592c76ec93e41b54701376f4b02366a3bdbd127d3472d73ae277d450d0f" }
          }
        },
        "candidateBatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestFileSha256","manifestDigest"],
          "properties": {
            "manifestFileSha256": { "const": "44ab0a7dd761bbc79e554a21003b7e67b65b6e80b6c1b3830179caedab509872" },
            "manifestDigest": { "const": "ec75baee68bc73b8c8e1812dddbf6dbe5cc0dfdc4d0a66938a16c6db87536dbf" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId","sha256","size"],
          "properties": {
            "sourceId": { "const": "r16-demo-source" },
            "sha256": { "const": "7b484abef5de1569e1b7f91a5d780f17c6d687ef68b3c42c9e54375f4e5e434b" },
            "size": { "const": 763377 }
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId","sha256","size"],
      "properties": {
        "sourceId": { "const": "r16-demo-source" },
        "sha256": { "const": "7b484abef5de1569e1b7f91a5d780f17c6d687ef68b3c42c9e54375f4e5e434b" },
        "size": { "const": 763377 }
      }
    },
    "candidate_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestFileSha256","manifestDigest"],
      "properties": {
        "manifestFileSha256": { "const": "44ab0a7dd761bbc79e554a21003b7e67b65b6e80b6c1b3830179caedab509872" },
        "manifestDigest": { "const": "ec75baee68bc73b8c8e1812dddbf6dbe5cc0dfdc4d0a66938a16c6db87536dbf" }
      }
    },
    "attachment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytesPerFile","oversizeBehavior"],
      "properties": {
        "maxBytesPerFile": { "const": 500000000 },
        "oversizeBehavior": { "const": "ineligible_without_explicit_derivative" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order","candidateId","final","renderExport","technicalQa",
          "attachmentEligibility","reviewAttachment"
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 0, "maximum": 2 },
          "candidateId": { "type": "string", "minLength": 1 },
          "final": {
            "type": "object",
            "required": ["path","name","sha256","size"]
          },
          "renderExport": {
            "type": "object",
            "required": ["path","digest","fileSha256","producerSha"]
          },
          "technicalQa": {
            "type": "object",
            "required": ["passed","evidenceSha256","checkCount","failedChecks"]
          },
          "attachmentEligibility": {
            "type": "object",
            "required": ["eligible","maxBytes","reason"]
          },
          "reviewAttachment": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["file","derivative"]
              }
            ]
          }
        }
      }
    }
  }
}
